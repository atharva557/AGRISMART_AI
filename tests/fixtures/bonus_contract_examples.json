  "negative_acceptance_cases": [
    {
      "change": "A: supplied row_id exists, but feature values differ from that pinned row",
      "expected": "INVALID_INPUT"
    },
    {
      "change": "A: source-classifier request uses purpose=farm_advisory",
      "expected": "UNSUPPORTED_CONTEXT"
    },
    {
      "change": "B: soil moisture remains labelled sensor_percent without a calibration reference",
      "expected": "NEEDS_DATA"
    },
    {
      "change": "B: field_capacity <= wilting_point",
      "expected": "INVALID_INPUT"
    },
    {
      "change": "C: provider data have missing hourly intervals",
      "expected": "INVALID_INPUT"
    },
    {
      "change": "C: forecast envelope reaching analysis exceeds the six-hour acquisition-age policy",
      "note": "Normal stale cache entries trigger a refetch before analysis.",
      "expected": "STALE_DATA"
    },
    {
      "change": "D: combine simulated baseline and measured current inputs",
      "expected": "UNSUPPORTED_CONTEXT"
    },
    {
      "change": "D: baseline water is zero",
      "expected": "NEEDS_DATA"
    }
  ],
  "planned_acceptance_cases": [
    {
      "change": "A: use next-day forecast rainfall as farm climate evidence",
      "desired_status": "UNSUPPORTED_CONTEXT",
      "current_behavior": "No field-input mapping exists. Purpose=farm_advisory is rejected, but an in-range numeric experiment without row_id cannot be checked for rainfall provenance."
    },
    {
      "change": "B: moisture observation lies in the future or is stale",
      "desired_status": "INVALID_INPUT or STALE_DATA",
      "current_behavior": "Evidence timestamps are not parsed; a structurally valid calculation can still return OK or SIMULATED."
    },
    {
      "change": "B: calibration reference text does not resolve to a valid calibration record",
      "desired_status": "NEEDS_DATA",
      "current_behavior": "Only a non-empty calibration_reference is checked, not the referenced record."
    },
    {
      "change": "D: proposed irrigation is relabelled as observed water, or a measured cycle has not ended",
      "desired_status": "UNSUPPORTED_CONTEXT",
      "current_behavior": "Evidence kinds and period ordering are checked, but provenance and completion are not authenticated."
    },
    {
      "change": "Request contains an unknown field",
      "desired_status": "INVALID_INPUT",
      "current_behavior": "Unknown fields are currently ignored; strict schemas remain planned."
    }
  ]
}
