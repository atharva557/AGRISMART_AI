  "negative_acceptance_cases": [
    {
      "change": "A: substitute C's next-day rainfall for source rainfall",
      "expected": "UNSUPPORTED_CONTEXT"
    },
    {
      "change": "A: source row values differ from pinned row",
      "expected": "INVALID_INPUT"
    },
    {
      "change": "B: divide sensor_percent by 100 without a calibration mapping",
      "expected": "NEEDS_DATA"
    },
    {
      "change": "B: observation lies in the future",
      "expected": "INVALID_INPUT"
    },
    {
      "change": "B: field_capacity <= wilting_point",
      "expected": "INVALID_INPUT"
    },
    {
      "change": "C: provider data have missing hourly intervals",
      "expected": "DATA_UNAVAILABLE"
    },
    {
      "change": "C: cached forecast exceeds acquisition-age policy",
      "expected": "STALE_DATA"
    },
    {
      "change": "D: replace measured water total with proposed irrigation",
      "expected": "UNSUPPORTED_CONTEXT"
    },
    {
      "change": "D: combine simulated baseline and measured current inputs",
      "expected": "UNSUPPORTED_CONTEXT"
    },
    {
