{
  "name": "agrismart-ai",
  "version": "1.0.1",
  "description": "AgriSmart AI - Smart Agricultural Diagnostics & Advisory System",
  "main": "index.js",
  "scripts": {
    "dev": "webpack --mode development --watch",
    "build": "webpack --mode production",
    "build:css": "tailwindcss -i ./app/static/css/src/main.css -o ./app/static/css/dist/main.min.css --minify",
    "build:css:dev": "tailwindcss -i ./app/static/css/src/main.css -o ./app/static/css/dist/main.min.css --watch",
    "build:all": "npm run build:css && npm run build",
    "test:frontend": "node --test tests/frontend/*.test.mjs",
    "clean": "rimraf app/static/css/dist app/static/js/dist"
  },
  "keywords": [
    "agriculture",
    "ai",
    "crop-disease",
    "precision-farming"
  ],
  "author": "AgriSmart AI Team",
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.7",
    "autoprefixer": "^10.4.16",
    "css-loader": "^6.8.1",
    "css-minimizer-webpack-plugin": "^5.0.1",
    "mini-css-extract-plugin": "^2.7.6",
    "postcss": "^8.4.32",
    "postcss-loader": "^7.3.3",
    "rimraf": "^5.0.5",
    "tailwindcss": "^3.3.6",
    "terser-webpack-plugin": "^5.3.9",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atharva557/AGRISMART_AI.git"
  },
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/atharva557/AGRISMART_AI/issues"
  },
  "homepage": "https://github.com/atharva557/AGRISMART_AI#readme"
}
